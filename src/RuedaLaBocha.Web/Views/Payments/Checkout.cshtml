@{
    ViewData["Title"] = "Pay deposit";
    var prefilledReservaId = ViewData["ReservaId"] as string;
    var hasPrefilledReservaId = !string.IsNullOrWhiteSpace(prefilledReservaId);
    var prefilledAmount = ViewData["Amount"] as decimal?;
    var isGroup = Guid.TryParse(prefilledReservaId, out _);
}

<h1>Pay deposit</h1>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<p class="text-muted">Enter the reservation reference and the deposit amount to create a Padi payment link.</p>
@if (isGroup)
{
    <p class="alert alert-info">Grupo de turnos contiguos: un solo pago cubre toda la reserva.</p>
}

<form asp-action="Create" method="post" class="col-md-6">
    <div class="mb-3">
        <label for="reservaId" class="form-label">Reservation reference</label>
        @if (hasPrefilledReservaId)
        {
            <input name="reservaId" id="reservaId" class="form-control" required maxlength="64" value="@prefilledReservaId" readonly />
            <div class="form-text">Prefilled from your booking. Continue with the deposit amount.</div>
        }
        else
        {
            <input name="reservaId" id="reservaId" class="form-control" required maxlength="64" />
        }
    </div>
    <div class="mb-3">
        <label for="amount" class="form-label">Deposit amount (ARS, minimum 10,000)</label>
        <input name="amount" id="amount" type="number" min="10000" step="0.01" class="form-control" required value="@(prefilledAmount?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))" @(prefilledAmount is > 0 ? "readonly" : "") />
        <div class="form-text">The minimum deposit (seña) is ARS 10,000.</div>
    </div>
    @* One link per click: Padi has no idempotency key, so double-submitting mints two links. *@
    <button type="submit" class="btn btn-primary" onclick="this.disabled=true;this.form.submit();">Continue to Padi</button>
</form>
