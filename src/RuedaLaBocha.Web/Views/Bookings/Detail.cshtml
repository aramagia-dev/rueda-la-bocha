@model Booking
@{
    ViewData["Title"] = "Detalle de la reserva";
    var hold = ViewBag.Hold as BookingHold;
}
<div class="page-heading"><p class="eyebrow">RESERVAS</p><h1>Detalle de la reserva</h1></div>
<dl class="management-panel p-4 mb-4">
    <dt>Cancha</dt><dd>@Model.Court.Name</dd>
    <dt>Fecha</dt><dd>@Model.Date.ToString("dd/MM/yyyy")</dd>
    <dt>Horario</dt><dd>@Model.StartTime.ToString("HH:mm") - @Model.EndTime.ToString("HH:mm")</dd>
    <dt>Precio</dt><dd>ARS @Model.PriceArs.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("es-AR"))</dd>
    <dt>Estado</dt><dd>@Model.Status</dd>
</dl>
@if (TempData["PadiError"] is string padiError)
{
    <p class="alert alert-warning" role="alert">@padiError</p>
}
@if (hold is not null)
{
    <section class="management-panel p-4 mb-4" aria-label="Pago total con Padi (demo)">
        <h2 class="h5">Pago total con Padi (demo)</h2>
        <p>Estado: <strong>Pagado</strong></p>
        <p>ID de pago Padi: @hold.PadiPaymentId</p>
        @if (!string.IsNullOrEmpty(hold.CheckoutUrl))
        {
            <p><a href="@hold.CheckoutUrl" target="_blank" rel="noopener">Comprobante en Padi</a></p>
        }
    </section>
}
else if (Model.Status == BookingStatus.Active)
{
    <p class="text-muted">Reserva activa anterior al pago total: no requiere ni admite otro cobro (demo).</p>
}
@if (Model.Status == BookingStatus.Active)
{
    <form method="post" asp-action="Cancel" asp-route-id="@Model.Id" class="mb-3">
        <button class="btn btn-danger" type="submit">Cancelar reserva</button>
    </form>
}
<a asp-action="Mine">Volver a mis reservas</a>
