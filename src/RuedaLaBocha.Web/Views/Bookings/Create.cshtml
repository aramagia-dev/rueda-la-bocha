@{
    ViewData["Title"] = "Reservar cancha";
    var court = ViewData["Court"] as Court;
    var date = ViewData["Date"] as DateOnly?;
    var start = ViewData["StartTime"] as TimeOnly?;
}
<div class="page-heading"><p class="eyebrow">RESERVAS</p><h1>Confirmar reserva</h1><p class="text-muted">Revisá la cancha, la fecha y el horario antes de confirmar. La reserva dura @BookingPolicy.DurationMinutes minutos (@BookingPolicy.PriceDisplay).</p><partial name="_CourtPolicy" /></div>
@if (court is not null && date.HasValue && start.HasValue)
{
    <div class="management-panel p-4 mb-4">
        <dl><dt>Cancha</dt><dd>@court.Name</dd><dt>Fecha</dt><dd>@date.Value.ToString("dd/MM/yyyy")</dd><dt>Horario</dt><dd>@start.Value.ToString("HH:mm") - @start.Value.AddMinutes(BookingPolicy.DurationMinutes).ToString("HH:mm")</dd><dt>Precio</dt><dd>@BookingPolicy.PriceDisplay</dd></dl>
        <form method="post" asp-action="Create">
            <input type="hidden" name="courtId" value="@court.Id" />
            <input type="hidden" name="date" value="@date.Value.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="startTime" value="@start.Value.ToString("HH:mm")" />
            <button class="btn btn-primary" type="submit">Confirmar reserva</button>
            <a class="btn btn-outline-primary" asp-controller="Reservas" asp-action="Index" asp-route-fecha="@date.Value.ToString("yyyy-MM-dd")">Volver a consultar</a>
        </form>
    </div>
}
else
{
<form method="post" asp-action="Create" class="management-panel p-4 mb-4">
    <label for="courtId" class="form-label">Cancha</label>
    <input id="courtId" name="courtId" type="number" min="1" class="form-control mb-3" required />
    <label for="date" class="form-label">Fecha</label>
    <input id="date" name="date" type="date" class="form-control mb-3" required />
    <label for="startTime" class="form-label">Horario de inicio</label>
    <input id="startTime" name="startTime" type="time" step="3600" class="form-control mb-3" required />
    <button class="btn btn-primary" type="submit">Confirmar reserva</button>
</form>
}
<a asp-action="Mine">Ver mis reservas</a>
