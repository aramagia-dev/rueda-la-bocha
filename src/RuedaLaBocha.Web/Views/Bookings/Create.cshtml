@{
    ViewData["Title"] = "Reservar cancha";
    var courtId = ViewData["CourtId"] as int?;
    var date = ViewData["Date"] as string;
    var startTime = ViewData["StartTime"] as string;
    var hours = ViewData["Hours"] as int? ?? 1;
}
<div class="page-heading"><p class="eyebrow">RESERVAS</p><h1>Reservar cancha</h1><p class="text-muted">Elegí la cancha, la fecha y el horario. La reserva dura @BookingPolicy.DurationMinutes minutos (@BookingPolicy.PriceDisplay por hora).</p><p class="text-muted">Promo Mon-Thu: 3 contiguous hours for ARS 45.000 total. Otherwise ARS 40.000 per hour.</p></div>
<form method="post" asp-action="Create" class="management-panel p-4 mb-4">
    <label for="courtId" class="form-label">Cancha</label>
    <input id="courtId" name="courtId" type="number" min="1" class="form-control mb-3" required value="@courtId" />
    <label for="date" class="form-label">Fecha</label>
    <input id="date" name="date" type="date" class="form-control mb-3" required value="@date" />
    <label for="startTime" class="form-label">Horario de inicio</label>
    <input id="startTime" name="startTime" type="time" step="3600" class="form-control mb-3" required value="@startTime" />
    <label for="hours" class="form-label">Horas contiguas (1-3)</label>
    <input id="hours" name="hours" type="number" min="1" max="3" value="@hours" class="form-control mb-3" required />
    <button class="btn btn-primary" type="submit">Confirmar reserva</button>
</form>
<a asp-action="Mine">Ver mis reservas</a>
