@model ClosureForm
@{
    var court = (Court)ViewData["Court"]!;
    ViewData["Title"] = "Configurar bloqueo";
}
<div class="page-heading"><p class="eyebrow">ADMINISTRACIÓN</p><h1>Configurar bloqueo</h1><p class="text-muted">@court.Name · El bloqueo afecta solo a la fecha elegida.</p></div>
<form method="post" class="management-panel p-4" asp-route-courtId="@court.Id" asp-route-id="@ViewData["RuleId"]">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <div class="mb-3"><label asp-for="Date" class="form-label"></label><input asp-for="Date" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" required /><span asp-validation-for="Date" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="StartTime" class="form-label"></label><input asp-for="StartTime" type="time" asp-format="{0:HH:mm}" step="60" class="form-control" required /><span asp-validation-for="StartTime" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="EndTime" class="form-label"></label><input asp-for="EndTime" type="time" asp-format="{0:HH:mm}" step="60" class="form-control" required /><span asp-validation-for="EndTime" class="text-danger"></span></div>
    <p class="text-muted">Todos los turnos que se crucen con este intervalo dejarán de aparecer en la consulta pública. No modifica los horarios semanales.</p>
    <button class="btn btn-primary" type="submit">Guardar bloqueo</button>
    <a class="btn btn-outline-secondary" asp-action="Manage" asp-route-courtId="@court.Id">Cancelar</a>
</form>
