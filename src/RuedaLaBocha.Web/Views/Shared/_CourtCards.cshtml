@model IReadOnlyList<Court>
@if (Model.Count == 0)
{
    <div class="empty-state"><span class="empty-icon" aria-hidden="true">⚽</span><h3>Todavía no hay canchas publicadas</h3><p>Las canchas activas del complejo aparecerán aquí.</p></div>
}
else
{
    <div class="court-grid">
        @foreach (var court in Model)
        {
            <article class="court-card">
                <div class="court-art"><img src="~/images/football-pitch.svg" alt="" loading="lazy" width="800" height="560" /><span>FÚTBOL 5</span></div>
                <div class="court-card-body"><h3>@court.Name</h3><p class="court-description">@(string.IsNullOrWhiteSpace(court.Description) ? "Cancha de fútbol 5 del complejo." : court.Description)</p><partial name="_CourtPolicy" /><a class="btn btn-outline-primary" asp-controller="Availability" asp-action="Index" asp-route-courtId="@court.Id" aria-label="Consultar disponibilidad de @court.Name">Consultar disponibilidad</a></div>
            </article>
        }
    </div>
}
