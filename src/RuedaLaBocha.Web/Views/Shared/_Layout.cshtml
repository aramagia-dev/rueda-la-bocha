<!DOCTYPE html>
<html lang="es-AR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Rueda la Bocha</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RuedaLaBocha.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg" aria-label="Navegación principal">
            <div class="container">
                <a class="brand" asp-area="" asp-controller="Home" asp-action="Index"><span class="brand-mark" aria-hidden="true">⚽</span><span><strong>Rueda la Bocha</strong><small>COMPLEJO DE FÚTBOL 5</small></span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-navigation" aria-controls="main-navigation" aria-expanded="false" aria-label="Abrir menú de navegación"><span class="navbar-toggler-icon"></span></button>
                <div class="collapse navbar-collapse" id="main-navigation">
                    <ul class="navbar-nav main-links">
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Courts" asp-action="Index">Canchas</a></li>
                        @if (User.IsInRole(RuedaLaBocha.Web.Security.AppRoles.Administrator))
                        {
                            <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Courts" asp-action="Manage">Administrar canchas</a></li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <main id="main-content" class="site-main @(ViewData["FullWidth"] is true ? "" : "container page-section")" tabindex="-1">
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="container footer-content">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index"><span class="brand-mark" aria-hidden="true">⚽</span><span><strong>Rueda la Bocha</strong><small>El punto de encuentro de tu equipo.</small></span></a>
            <nav class="footer-links" aria-label="Enlaces del pie de página">
                <a asp-area="" asp-controller="Courts" asp-action="Index">Ver canchas</a>
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a>
                @if (User.IsInRole(RuedaLaBocha.Web.Security.AppRoles.Administrator))
                {
                    <a asp-area="" asp-controller="Courts" asp-action="Manage">Acceso administración</a>
                }
            </nav>
            <p class="footer-caption">Fútbol 5 · Turnos de @BookingPolicy.DurationMinutes minutos · @BookingPolicy.PriceDisplay por turno</p>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
