@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
<ul class="navbar-nav account-links">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Manage/Index">Mi cuenta</a></li>
    <li class="nav-item">
        <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="btn btn-outline-primary">Cerrar sesión</button>
        </form>
    </li>
}
else
{
    <li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Register">Crear cuenta</a></li>
    <li class="nav-item"><a class="btn btn-primary" asp-area="Identity" asp-page="/Account/Login">Ingresar</a></li>
}
</ul>
