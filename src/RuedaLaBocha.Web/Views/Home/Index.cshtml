@model IReadOnlyList<Court>
@{
    ViewData["Title"] = "Inicio";
    ViewData["FullWidth"] = true;
}
<div class="home-page">
    <section class="hero" aria-labelledby="hero-title">
        <div class="container hero-grid">
            <div class="hero-copy">
                <p class="eyebrow hero-label"><span aria-hidden="true">●</span> TU COMPLEJO DE FÚTBOL 5</p>
                <h1 id="hero-title">Tu próximo partido<br />empieza acá.</h1>
                <p class="hero-description">La cancha es el punto de encuentro. Conoce nuestro complejo y elige dónde jugar tu próximo partido.</p>
                <div class="hero-actions">
                    <a class="btn btn-primary" asp-controller="Courts" asp-action="Index">Ver canchas <span aria-hidden="true">→</span></a>
                    <a class="text-link" href="#el-complejo">Conocer el complejo <span aria-hidden="true">↓</span></a>
                </div>
                <partial name="_CourtPolicy" />
            </div>
            <div class="hero-visual" aria-hidden="true">
                <img class="hero-pitch" src="~/images/football-pitch.svg" alt="" width="800" height="560" />
                <span class="pitch-label">RUEDA LA BOCHA</span>
                <div class="hero-note"><span class="note-icon">✓</span><div><strong>EL PARTIDO EMPIEZA ACÁ</strong><span>Fútbol 5. Un mismo lugar para encontrarse.</span></div></div>
            </div>
        </div>
    </section>
    <section id="el-complejo" class="container section-block" aria-labelledby="courts-title">
        <div class="section-heading">
            <div><p class="eyebrow">EL COMPLEJO</p><h2 id="courts-title">Elige dónde quieres jugar</h2><p class="text-muted">Conoce nuestras canchas de fútbol 5. Un mismo precio para todos los turnos.</p></div>
            <a class="text-link" asp-controller="Courts" asp-action="Index">Ver todas <span aria-hidden="true">→</span></a>
        </div>
        <partial name="_CourtCards" model="Model" />
    </section>
    <section class="complex-details" aria-labelledby="details-title">
        <div class="container section-block">
            <p class="eyebrow">SIMPLE, DESDE EL PRINCIPIO</p><h2 id="details-title">Todo listo para tu próximo partido</h2>
            <div class="detail-grid">
                <article><span class="step-number" aria-hidden="true">01</span><h3>Solo fútbol 5</h3><p>Todas las canchas del complejo están destinadas a la misma pasión.</p></article>
                <article><span class="step-number" aria-hidden="true">02</span><h3>@BookingPolicy.DurationMinutes minutos de juego</h3><p>Una duración fija por turno para organizar el encuentro con tu equipo.</p></article>
                <article><span class="step-number" aria-hidden="true">03</span><h3>@BookingPolicy.PriceDisplay por turno</h3><p>Precio total del turno, igual para todas las canchas del complejo.</p></article>
            </div>
        </div>
    </section>
</div>
