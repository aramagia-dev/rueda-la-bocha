@model List<Booking>
@{
    ViewData["Title"] = "Todas las reservas";
}
<div class="page-heading"><p class="eyebrow">ADMINISTRACIÓN</p><h1>Todas las reservas</h1><p class="text-muted">Filtrá por fecha, cancha, estado o usuario. Los filtros se combinan.</p></div>
@if (TempData["BookingMessage"] is string message)
{
    <p class="alert alert-success">@message</p>
}
<form method="get" asp-action="Index" class="management-panel p-4 mb-4">
    <label for="date" class="form-label">Fecha</label>
    <input id="date" name="date" type="date" class="form-control mb-3" />
    <label for="courtId" class="form-label">Cancha</label>
    <input id="courtId" name="courtId" type="number" min="1" class="form-control mb-3" />
    <label for="status" class="form-label">Estado</label>
    <select id="status" name="status" class="form-control mb-3">
        <option value="">Todos</option>
        <option value="Active">Active</option>
        <option value="Cancelled">Cancelled</option>
    </select>
    <label for="userId" class="form-label">Usuario</label>
    <input id="userId" name="userId" type="text" class="form-control mb-3" />
    <button class="btn btn-primary" type="submit">Filtrar reservas</button>
</form>
@if (Model.Count == 0)
{
    <p class="empty-state">No hay reservas para estos filtros.</p>
}
else
{
    <ul class="list-group mb-3">
        @foreach (var booking in Model)
        {
            <li class="list-group-item">
                <strong>@booking.Date.ToString("dd/MM/yyyy") @booking.StartTime.ToString("HH:mm") - @booking.EndTime.ToString("HH:mm")</strong>
                <span class="text-muted">@booking.Court.Name · @BookingPolicy.PriceDisplay · @booking.Status</span>
                @if (booking.Status == BookingStatus.Active)
                {
                    <form method="post" asp-action="Cancel" asp-route-id="@booking.Id" class="d-inline">
                        <button class="btn btn-link" type="submit">Cancelar reserva</button>
                    </form>
                }
            </li>
        }
    </ul>
}
