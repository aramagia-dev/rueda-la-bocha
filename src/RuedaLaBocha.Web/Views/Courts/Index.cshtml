@model IReadOnlyList<Court>
@{
    ViewData["Title"] = "Courts";
}
<h1>Football courts</h1>
<p>@BookingPolicy.Sport · @BookingPolicy.DurationMinutes minutes · @BookingPolicy.PriceDisplay per slot</p>
@if (Model.Count == 0)
{
    <p>No active courts are currently available.</p>
}
<div class="row g-3">
    @foreach (var court in Model)
    {
        <div class="col-md-6 col-lg-4">
            <article class="card h-100">
                <div class="card-body">
                    <h2 class="h5 card-title">@court.Name</h2>
                    <p class="card-text">@court.Description</p>
                </div>
            </article>
        </div>
    }
</div>
