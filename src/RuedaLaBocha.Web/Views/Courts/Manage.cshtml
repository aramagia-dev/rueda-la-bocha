@model IReadOnlyList<Court>
@{
    ViewData["Title"] = "Administrar canchas";
}
<div class="section-heading page-heading">
    <div><p class="eyebrow">ADMINISTRACIÓN</p><h1>Administrar canchas</h1><p class="text-muted">Gestiona los datos y la publicación de las canchas del complejo.</p><partial name="_CourtPolicy" /></div>
    <a class="btn btn-primary" asp-action="Create">Nueva cancha <span aria-hidden="true">+</span></a>
</div>
@if (Model.Count == 0)
{
    <div class="empty-state"><span class="empty-icon" aria-hidden="true">⚽</span><h2>Todavía no hay canchas creadas</h2><p>Usa «Nueva cancha» para agregar la primera al complejo.</p></div>
}
else
{
    <div class="management-panel"><div class="table-responsive" tabindex="0" role="region" aria-label="Listado de canchas; desplaza horizontalmente en pantallas pequeñas">
        <table class="table court-table align-middle mb-0">
            <caption class="visually-hidden">Canchas activas e inactivas del complejo</caption>
            <thead><tr><th scope="col">Nombre</th><th scope="col">Descripción</th><th scope="col">Estado</th><th scope="col">Acciones</th></tr></thead>
            <tbody>
            @foreach (var court in Model)
            {
                <tr>
                    <th scope="row">@court.Name</th><td class="description-cell">@court.Description</td><td><span class="status-badge @(court.IsActive ? "status-active" : "status-inactive")">@(court.IsActive ? "Activa" : "Inactiva")</span></td>
                    <td><div class="table-actions">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@court.Id" aria-label="Editar @court.Name">Editar</a>
                        <a class="btn btn-sm btn-outline-primary" asp-controller="Availability" asp-action="Manage" asp-route-courtId="@court.Id" aria-label="Configurar horarios de @court.Name">Horarios</a>
                        @if (court.IsActive)
                        {
                            <form asp-action="Deactivate" asp-route-id="@court.Id" method="post"><button class="btn btn-sm btn-outline-danger" type="submit" aria-label="Desactivar @court.Name">Desactivar</button></form>
                        }
                    </div></td>
                </tr>
            }
            </tbody>
        </table>
    </div></div>
    <p class="management-hint">Las canchas inactivas no se muestran en el catálogo. Puedes reactivarlas desde «Editar»; su historial se conserva.</p>
}
