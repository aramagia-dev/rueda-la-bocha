@model IReadOnlyList<Court>
@{
    ViewData["Title"] = "Manage courts";
}
<h1>Manage courts</h1>
<p>@BookingPolicy.Sport · @BookingPolicy.DurationMinutes minutes · @BookingPolicy.PriceDisplay per slot</p>
<a class="btn btn-primary mb-3" asp-action="Create">Create court</a>
@if (Model.Count == 0)
{
    <p>No courts have been created yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th scope="col">Name</th><th scope="col">Description</th><th scope="col">Status</th><th scope="col">Actions</th></tr></thead>
            <tbody>
                @foreach (var court in Model)
                {
                    <tr>
                        <td>@court.Name</td><td>@court.Description</td><td>@(court.IsActive ? "Active" : "Inactive")</td>
                        <td>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@court.Id">Edit</a>
                            @if (court.IsActive)
                            {
                                <form asp-action="Deactivate" asp-route-id="@court.Id" method="post" class="d-inline">
                                    <button class="btn btn-sm btn-outline-danger" type="submit" aria-label="Deactivate @court.Name">Deactivate</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
